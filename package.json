{
  "name": "@gerrithoskins/capacitor-clarity-plugin",
  "version": "0.0.1",
  "description": "Microsoft Clarity session replay and analytics for Capacitor 8, with typed Android, iOS and web APIs.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "Package.swift",
    "GerrithoskinsCapacitorClarityPlugin.podspec",
    "THIRD_PARTY_NOTICES.md"
  ],
  "author": "Gerrit Hoskins <gerrit.hoskins@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gerrithoskins/capacitor-clarity-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/gerrithoskins/capacitor-clarity-plugin/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "clarity",
    "analytics",
    "ionic"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "node scripts/native-check.mjs ios",
    "verify:android": "node scripts/native-check.mjs android",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && node scripts/native-check.mjs swiftlint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,mjs,cjs,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api ClarityPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm test && npm run lint && node scripts/check-package.mjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepare": "npm run build",
    "verify:package": "npm run build && node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.0.0",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.7",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0 <9.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "dependencies": {
    "@microsoft/clarity": "1.0.2"
  },
  "homepage": "https://github.com/gerrithoskins/capacitor-clarity-plugin#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
